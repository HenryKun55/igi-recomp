+// Vertex attribute lookups of the ffp vertex programs, memoized: the by-name search
+// would otherwise run for every attribute on every draw.
+#define FFP_PARAM_MEMO_SIZE 64
+static int ffp_param_memo_num = 0, ffp_param_memo_next = 0;
+static struct {
+	const SceGxmProgram *prog;
+	const char *name;
+	const SceGxmProgramParameter *param;
+	unsigned int index;
+} ffp_param_memo[FFP_PARAM_MEMO_SIZE];
+
+static void ffp_param_memo_reset(void) {
+	ffp_param_memo_num = 0;
+	ffp_param_memo_next = 0;
+}
+
+static const SceGxmProgramParameter *ffp_find_param(const char *name) {
+	for (int i = 0; i < ffp_param_memo_num; i++) {
+		if (ffp_param_memo[i].prog == ffp_vertex_program && (ffp_param_memo[i].name == name || !strcmp(ffp_param_memo[i].name, name)))
+			return ffp_param_memo[i].param;
+	}
+	const SceGxmProgramParameter *param = sceGxmProgramFindParameterByName(ffp_vertex_program, name);
+	if (param) {
+		ffp_param_memo[ffp_param_memo_next].prog = ffp_vertex_program;
+		ffp_param_memo[ffp_param_memo_next].name = name;
+		ffp_param_memo[ffp_param_memo_next].param = param;
+		ffp_param_memo[ffp_param_memo_next].index = sceGxmProgramParameterGetResourceIndex(param);
+		ffp_param_memo_next = (ffp_param_memo_next + 1) % FFP_PARAM_MEMO_SIZE;
+		if (ffp_param_memo_num < FFP_PARAM_MEMO_SIZE)
+			ffp_param_memo_num++;
+	}
+	return param;
+}
+
+static unsigned int ffp_param_index(const SceGxmProgramParameter *param) {
+	for (int i = 0; i < ffp_param_memo_num; i++) {
+		if (ffp_param_memo[i].param == param)
+			return ffp_param_memo[i].index;
+	}
+	return sceGxmProgramParameterGetResourceIndex(param);
+}
+
+// Patched ffp vertex programs by (program, attributes, streams): patching goes
+// through the shader patcher's hash lookup on every draw otherwise.
+#define FFP_PATCH_CACHE_SIZE 32
+typedef struct {
+	SceGxmShaderPatcherId id;
+	int num;
+	SceGxmVertexAttribute attrs[FFP_VERTEX_ATTRIBS_NUM];
+	SceGxmVertexStream streams[FFP_VERTEX_ATTRIBS_NUM];
+	SceGxmVertexProgram *prog;
+} ffp_patch_entry;
+static ffp_patch_entry ffp_patch_cache[FFP_PATCH_CACHE_SIZE];
+static int ffp_patch_cache_num = 0, ffp_patch_cache_next = 0, ffp_patch_cache_last = -1;
+
+static void ffp_patch_cache_reset(void) {
+	ffp_patch_cache_num = 0;
+	ffp_patch_cache_next = 0;
+	ffp_patch_cache_last = -1;
+}
+
+static inline int ffp_patch_entry_matches(const ffp_patch_entry *e, SceGxmShaderPatcherId id, const SceGxmVertexAttribute *attrs, const SceGxmVertexStream *streams, int num) {
+	return e->id == id && e->num == num && !memcmp(e->attrs, attrs, num * sizeof(SceGxmVertexAttribute)) && !memcmp(e->streams, streams, num * sizeof(SceGxmVertexStream));
+}
+
+static void ffp_patch_vertex_program(SceGxmShaderPatcherId id, const SceGxmVertexAttribute *attrs, const SceGxmVertexStream *streams, int num, SceGxmVertexProgram **prog) {
+	if (num > FFP_VERTEX_ATTRIBS_NUM) {
+		patch_vertex_program(gxm_shader_patcher, id, attrs, num, streams, num, prog);
+		return;
+	}
+	if (ffp_patch_cache_last >= 0 && ffp_patch_entry_matches(&ffp_patch_cache[ffp_patch_cache_last], id, attrs, streams, num)) {
+		*prog = ffp_patch_cache[ffp_patch_cache_last].prog;
+		return;
+	}
+	for (int i = 0; i < ffp_patch_cache_num; i++) {
+		if (ffp_patch_entry_matches(&ffp_patch_cache[i], id, attrs, streams, num)) {
+			ffp_patch_cache_last = i;
+			*prog = ffp_patch_cache[i].prog;
+			return;
+		}
+	}
+	*prog = NULL;
+	patch_vertex_program(gxm_shader_patcher, id, attrs, num, streams, num, prog);
+	if (!*prog)
+		return;
+	ffp_patch_entry *e = &ffp_patch_cache[ffp_patch_cache_next];
+	e->id = id;
+	e->num = num;
+	memcpy(e->attrs, attrs, num * sizeof(SceGxmVertexAttribute));
+	memcpy(e->streams, streams, num * sizeof(SceGxmVertexStream));
+	e->prog = *prog;
+	ffp_patch_cache_last = ffp_patch_cache_next;
+	ffp_patch_cache_next = (ffp_patch_cache_next + 1) % FFP_PATCH_CACHE_SIZE;
+	if (ffp_patch_cache_num < FFP_PATCH_CACHE_SIZE)
+		ffp_patch_cache_num++;
+}
+
+// Patched ffp fragment programs by (program, blend, linked vertex program).
+#define FFP_FRAG_PATCH_CACHE_SIZE 32
+typedef struct {
+	SceGxmShaderPatcherId id;
+	uint32_t blend;
+	const SceGxmProgram *vprog;
+	SceGxmMultisampleMode msaa;
+	SceGxmFragmentProgram *prog;
+} ffp_frag_patch_entry;
+static ffp_frag_patch_entry ffp_frag_patch_cache[FFP_FRAG_PATCH_CACHE_SIZE];
+static int ffp_frag_patch_cache_num = 0, ffp_frag_patch_cache_next = 0;
+
+static void ffp_frag_patch_cache_reset(void) {
+	ffp_frag_patch_cache_num = 0;
+	ffp_frag_patch_cache_next = 0;
+}
+
+static void ffp_patch_fragment_program(SceGxmShaderPatcherId id, const SceGxmProgram *vprog, SceGxmFragmentProgram **prog) {
+	for (int i = 0; i < ffp_frag_patch_cache_num; i++) {
+		ffp_frag_patch_entry *e = &ffp_frag_patch_cache[i];
+		if (e->id == id && e->blend == blend_info.raw && e->vprog == vprog && e->msaa == msaa_mode) {
+			*prog = e->prog;
+			return;
+		}
+	}
+	*prog = NULL;
+	rebuild_frag_shader(id, prog, vprog, SCE_GXM_OUTPUT_REGISTER_FORMAT_UCHAR4);
+	if (!*prog)
+		return;
+	ffp_frag_patch_entry *e = &ffp_frag_patch_cache[ffp_frag_patch_cache_next];
+	e->id = id;
+	e->blend = blend_info.raw;
+	e->vprog = vprog;
+	e->msaa = msaa_mode;
+	e->prog = *prog;
+	ffp_frag_patch_cache_next = (ffp_frag_patch_cache_next + 1) % FFP_FRAG_PATCH_CACHE_SIZE;
+	if (ffp_frag_patch_cache_num < FFP_FRAG_PATCH_CACHE_SIZE)
+		ffp_frag_patch_cache_num++;
+}
