 	float4 position,
 #if num_textures > 0
+#if fog_coord == 1
+	float3 texcoord0, // z: fog coordinate
+#else
 	float2 texcoord0,
+#endif
 #if num_textures > 1
 	float2 texcoord1,
 #endif
@@ -108,6 +114,9 @@
 	float4 out vEmission : TEXCOORD6,
 #endif
 	float4 out vPosition : POSITION,
+#if fog_mode < 3
+	float out vFogDist : TEXCOORD7,
+#endif
 #if has_colors == 1 || lights_num > 0
 	float4 out vColor : COLOR,
 #endif
@@ -172,9 +181,9 @@
 
 #if num_textures > 0
 #if (fixed_mode_mask & 0x02) == 0x02
-	texcoord0 = GLFixed2ToFloat2(texcoord0);
+	texcoord0.xy = GLFixed2ToFloat2(texcoord0.xy);
 #endif
-	vTexcoord = mul(Ktexmat[0], float4(texcoord0, 0.f, 1.f)).xy;
+	vTexcoord = mul(Ktexmat[0], float4(texcoord0.xy, 0.f, 1.f)).xy;
 #if num_textures > 1
 #if (fixed_mode_mask & 0x04) == 0x04
 	texcoord1 = GLFixed2ToFloat2(texcoord1);
@@ -200,5 +209,13 @@
 	vColor = color;
 #endif
 	psize = Mpoint_size;
+	// Fog distance: the fog coordinate, else the eye-space depth (clip w)
+#if fog_mode < 3
+#if fog_coord == 1
+	vFogDist = texcoord0.z;
+#else
+	vFogDist = vPosition.w;
+#endif
+#endif
 }
 )";
